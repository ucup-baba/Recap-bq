rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is super admin based on email
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.email in ['ucupbaba0704@gmail.com', 'superbq@bqmail.com'];
    }
    
    // Helper function to get user document
    function getUserData() {
      return get(/databases/$(database)/documents/siqowwam_users/$(request.auth.uid)).data;
    }
    
    // Users collection
    match /siqowwam_users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Super admin can read/write all users
      allow read, write: if isSuperAdmin();
      // Users can create their own document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can update their own document (limited fields)
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Roles collection - only super admin can manage
    match /siqowwam_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }
    
    // Fund requests collection
    match /siqowwam_fund_requests/{requestId} {
      // Authenticated users can read their own requests
      allow read: if isAuthenticated() && 
                    (resource.data.userId == request.auth.uid || isSuperAdmin());
      // Authenticated users can create requests  
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only super admin can update (approve/reject) or delete
      allow update, delete: if isSuperAdmin();
    }
    
    // Transactions collection
    match /siqowwam_transactions/{transactionId} {
      allow read: if isAuthenticated() && 
                    (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    
    // General collection for backward compatibility
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }
    
    // Categories collection - for managing subcategories
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
