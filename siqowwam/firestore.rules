rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is super admin based on email
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.email in ['ucupbaba0704@gmail.com', 'superbq@bqmail.com'];
    }
    
    // Users collection
    match /siqowwam_users/{userId} {
      // Anyone authenticated can read users
      allow read: if isAuthenticated();
      // Anyone authenticated can update users (for balance updates)
      allow update: if isAuthenticated();
      // Super admin can do everything
      allow write: if isSuperAdmin();
      // Users can create their own document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Roles collection - Admin and Super Admin can manage
    match /siqowwam_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // Fund requests collection
    match /siqowwam_fund_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }
    
    // Transactions collection - SIMPLIFIED: all authenticated can write
    match /siqowwam_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // Legacy transactions collection
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }
    
    // Categories collection
    match /siqowwam_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // Old categories collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
