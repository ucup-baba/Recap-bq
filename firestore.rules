rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user role from users collection
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null ? userDoc.data.role : null;
    }
    
    // Helper function to check if user is super admin
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'super_admin');
    }
    
    // Helper function to check if user is koordinator
    function isKoordinator() {
      return isAuthenticated() && getUserRole() == 'koordinator';
    }
    
    // Helper function to check if user is kedisiplinan
    function isKedisiplinan() {
      return isAuthenticated() && getUserRole() == 'kedisplinan';
    }
    
    // Helper function to get user kelompok_id
    function getUserKelompokId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null ? userDoc.data.kelompok_id : null;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read their own profile
      // Admin and super_admin can read any user (for account management)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
      
      // Anyone authenticated can read all users (for leaderboard)
      allow list: if isAuthenticated();
      
      // Admin can create/update any user
      allow create, update: if isAdmin();
      
      // Users can create their own profile if it doesn't exist yet
      // This is needed for auto-creation during first login (e.g., kedisiplinan user)
      allow create: if isAuthenticated() 
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role is string;
      
      // Users can update their own profile (limited fields)
      // Allow update kelompok_id only if it's currently null (for auto-fix)
      allow update: if isAuthenticated() 
        && request.auth.uid == userId
        && (
          // Normal update: can't change email, displayName, role, kelompok_id
          (request.resource.data.diff(resource.data).unchangedKeys().hasAll(['email', 'displayName', 'role', 'kelompok_id']))
          ||
          // Auto-fix: can update kelompok_id if it's currently null
          (resource.data.kelompok_id == null 
           && request.resource.data.kelompok_id != null
           && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['email', 'displayName', 'role']))
        );
      
      // Nalya profile sub-collection (AI coach data)
      match /nalya_profile/{docId} {
        // Users can read/write their own Nalya profile
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Nalya history sub-collection (check-in history)
      match /nalya_history/{docId} {
        // Users can read/write their own Nalya history
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Reading log sub-collection (book reading progress)
      match /reading_log/{docId} {
        // Users can read/write their own reading log
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    // Daily reports collection
    match /daily_reports/{reportId} {
      // Helper to extract kelompok_id from document ID (format: {kelompokId}-{date})
      function getKelompokIdFromReportId() {
        return int(reportId.split('-')[0]);
      }
      
      // Helper to check if report belongs to user's kelompok
      function belongsToUserKelompok() {
        return getKelompokIdFromReportId() == getUserKelompokId();
      }
      
      // Koordinator can read reports from their own kelompok
      // Simplified: check document ID pattern instead of resource.data
      allow get: if isAuthenticated() && (
        isAdmin() || 
        (isKoordinator() && belongsToUserKelompok())
      );
      
      // Koordinator can list/query reports from their own kelompok
      allow list: if isAuthenticated() && (
        isAdmin() || 
        isKoordinator()
      );
      
      // Koordinator can create reports for their own kelompok
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isKoordinator() && request.resource.data.kelompok_id == getUserKelompokId())
      );
      
      // Admin can update any report (for validation)
      // Koordinator can update laporan sendiri hanya jika masih draft atau sudah ditolak.
      // Pending/verified harus terkunci.
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isKoordinator() 
          && request.resource.data.kelompok_id == getUserKelompokId()
          && (
            // Allow if document doesn't exist (first save as draft)
            !resource.exists ||
            // Allow if status is draft (auto-save while editing)
            resource.data.status == 'draft' ||
            // Allow if status is rejected (resubmit after admin rejection)
            resource.data.status == 'rejected'
          ))
      );
      
      // Admin can delete reports
      allow delete: if isAdmin();
    }
    
    // Area tasks collection (managed by admin)
    match /area_tasks/{area} {
      // Everyone authenticated can read
      allow read: if isAuthenticated();
      
      // Only admin can create/update/delete
      allow create, update, delete: if isAdmin();
    }
    
    // Kelompok members collection (managed by admin)
    match /kelompok_members/{kelompokId} {
      // Everyone authenticated can read
      allow read: if isAuthenticated();
      
      // Only admin can create/update/delete
      allow create, update, delete: if isAdmin();
    }
    
    // Groups collection (for weekly scores)
    match /groups/{groupId} {
      // Everyone authenticated can read
      allow read: if isAuthenticated();
      
      // Admin can create/update (for score updates)
      allow create, update: if isAdmin();
    }
    
    // Daily ibadah collection (personal tracking per user)
    match /daily_ibadah/{ibadahId} {
      // Helper to extract userId from document ID (format: {userId}-{date})
      function getUserIdFromId() {
        return ibadahId.split('-')[0];
      }
      
      // Check if document ID belongs to authenticated user
      function belongsToUser() {
        return getUserIdFromId() == request.auth.uid;
      }
      
      // User can read their own ibadah data
      // Document ID format: {userId}-{date}
      allow get: if isAuthenticated() && (
        // Admin can read all data
        isAdmin() ||
        // Kedisiplinan can read all data (for leaderboard)
        isKedisiplinan() ||
        // Koordinator (ketua kelompok) can read all data (for leaderboard)
        isKoordinator() ||
        // User can read if document ID belongs to them
        // This works even if document doesn't exist (for checking before creating)
        belongsToUser()
      );
      
      // User can list/query their own ibadah data
      allow list: if isAuthenticated() && (
        // Admin can query all
        isAdmin() ||
        // Kedisiplinan can query all (for leaderboard)
        isKedisiplinan() ||
        // Koordinator (ketua kelompok) can query all (for leaderboard)
        isKoordinator() ||
        // Regular users can query (with reasonable limit)
        // Note: Actual filtering by user_id should be done in the query
        (request.query.limit == null || request.query.limit <= 100)
      );
      
      // User can create/update their own ibadah data
      allow create, update: if isAuthenticated() && (
        // Validate user_id field matches authenticated user
        // Also check document ID starts with user's ID
        request.resource.data.user_id == request.auth.uid &&
        belongsToUser()
      );
      
      // Only admin can delete ibadah data
      allow delete: if isAdmin();
    }
    
    // Violation rules collection (master data)
    match /violation_rules/{ruleId} {
      // Everyone authenticated can read
      allow read: if isAuthenticated();
      
      // Only admin and kedisiplinan can create/update/delete
      allow create, update, delete: if isAdmin() || isKedisiplinan();
    }
    
    // Violation cases collection (case records)
    match /violation_cases/{caseId} {
      // Everyone authenticated can read
      allow read: if isAuthenticated();
      
      // Only admin and kedisiplinan can create
      allow create: if isAdmin() || isKedisiplinan();
      
      // Admin and kedisiplinan can update/delete
      allow update, delete: if isAdmin() || isKedisiplinan();
    }
    
    // Notification reminders collection
    match /notification_reminders/{reminderId} {
      // Super Admin can read all reminders
      allow read: if isSuperAdmin();
      
      // Regular users can read their own reminders
      allow read: if isAuthenticated() 
        && resource.data.user_id == request.auth.uid;
      
      // Super Admin can create reminders for any user
      allow create: if isSuperAdmin();
      
      // Regular users can create reminders for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.user_id == request.auth.uid;
      
      // Super Admin can update all reminders
      allow update: if isSuperAdmin();
      
      // Regular users can update their own reminders
      allow update: if isAuthenticated() 
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      
      // Super Admin can delete all reminders
      allow delete: if isSuperAdmin();
      
      // Regular users can delete their own reminders
      allow delete: if isAuthenticated() 
        && resource.data.user_id == request.auth.uid;
    }
    
    // Weekend reports collection
    match /weekend_reports/{reportId} {
      // Helper to extract kelompok_id from document ID (format: {date}_{kelompokId}_{reportType})
      function getKelompokIdFromWeekendReportId() {
        return int(reportId.split('_')[1]);
      }
      
      // Helper to check if report belongs to user's kelompok
      function weekendReportBelongsToUserKelompok() {
        return getKelompokIdFromWeekendReportId() == getUserKelompokId();
      }
      
      // Everyone authenticated can read weekend reports
      allow get, list: if isAuthenticated();
      
      // Koordinator can create/update reports for their own kelompok
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isKoordinator() && request.resource.data.kelompokId == getUserKelompokId())
      );
      
      // Admin can update any report (for validation)
      // Koordinator can update their own kelompok reports if draft or rejected
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isKoordinator() 
          && request.resource.data.kelompokId == getUserKelompokId()
          && (
            !resource.exists ||
            resource.data.status == 'draft' ||
            resource.data.status == 'rejected'
          ))
      );
      
      // Admin can delete reports
      allow delete: if isAdmin();
    }
    
    // Weekend area tasks collection (managed by admin)
    match /weekend_area_tasks/{area} {
      // Everyone authenticated can read
      allow read: if isAuthenticated();
      
      // Only admin can create/update/delete
      allow create, update, delete: if isAdmin();
    }
    
    // Running logs collection (personal running tracking)
    match /running_logs/{logId} {
      // Everyone authenticated can read their own running logs
      allow read: if isAuthenticated() && (
        // User can read their own data
        resource.data.odooId == request.auth.uid ||
        // Admin can read all
        isAdmin()
      );
      
      // Allow list queries with reasonable limit
      allow list: if isAuthenticated() && (
        request.query.limit == null || request.query.limit <= 100
      );
      
      // User can create running logs for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.odooId == request.auth.uid;
      
      // User can update their own running logs
      allow update: if isAuthenticated() && (
        resource.data.odooId == request.auth.uid ||
        isAdmin()
      );
      
      // Only admin can delete
      allow delete: if isAdmin();
    }
    
    // Study time records collection (mandatory study hour attendance)
    match /study_time_records/{recordId} {
      // Helper to extract kelompok_id from document ID (format: {date}_{kelompokId})
      function getKelompokIdFromStudyTimeId() {
        return int(recordId.split('_')[1]);
      }
      
      // Everyone authenticated can read study time records
      allow get, list: if isAuthenticated();
      
      // Koordinator can create/update records for their own kelompok
      allow create, update: if isAuthenticated() && (
        isAdmin() || 
        isKedisiplinan() ||
        (isKoordinator() && request.resource.data.kelompokId == getUserKelompokId())
      );
      
      // Admin and kedisiplinan can delete records
      allow delete: if isAdmin() || isKedisiplinan();
    }
    
    // Global data collection (shared across all users)
    match /global/{docId} {
      // Everyone authenticated can read global data
      allow read: if isAuthenticated();
      
      // Only authenticated users can write (for vocab generation)
      allow create, update: if isAuthenticated();
      
      // Only super admin can delete global data
      allow delete: if isSuperAdmin();
      
      // Sub-collections under global (e.g., daily_vocab/history)
      match /{subcollection}/{document=**} {
        // Everyone authenticated can read
        allow read: if isAuthenticated();
        
        // Authenticated users can create/update (for vocab caching)
        allow create, update: if isAuthenticated();
        
        // Only super admin can delete (for reset functionality)
        allow delete: if isSuperAdmin();
      }
    }
    
    // Memorable places collection (personal place bookmarks)
    match /memorable_places/{placeId} {
      // Users can read their own memorable places
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      
      // Allow list queries for authenticated users
      allow list: if isAuthenticated();
      
      // Users can create memorable places for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.createdBy == request.auth.uid;
      
      // Users can update their own memorable places
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      
      // Users can delete their own memorable places
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
    }
    
    // =====================================================
    // SIQowwam (Sistem Keuangan Baitul Qowwam) Collections
    // =====================================================
    
    // Helper function to check if user is SIQowwam super admin based on email
    function isSiqowwamSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.email in ['ucupbaba0704@gmail.com', 'superbq@bqmail.com'];
    }
    
    // SIQowwam Users collection
    match /siqowwam_users/{userId} {
      // Anyone authenticated can read users
      allow read: if isAuthenticated();
      // Anyone authenticated can update users (for balance updates)
      allow update: if isAuthenticated();
      // Super admin can do everything
      allow write: if isSiqowwamSuperAdmin();
      // Users can create their own document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // SIQowwam Roles collection - Admin and Super Admin can manage
    match /siqowwam_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // SIQowwam Fund requests collection
    match /siqowwam_fund_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isSiqowwamSuperAdmin();
    }
    
    // SIQowwam Transactions collection - SIMPLIFIED: all authenticated can write
    match /siqowwam_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // Legacy transactions collection
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }
    
    // SIQowwam Categories collection
    match /siqowwam_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // Old categories collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // SIQowwam Wallets collection
    match /siqowwam_wallets/{walletId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    // SIQowwam Projects collection
    match /siqowwam_projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    // Personal Finance Transactions (Me Tab)
    match /personal_transactions/{txId} {
      // User can read their own transactions
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        // Allow reading if filtering by userId in list query
        (request.query.limit != null)
      );
      
      // User can create their own transaction
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // User can update/delete their own transaction
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    // Santri Users collection (Bahasasantri.com)
    match /santri_users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // Math Battle Rooms (Bahasasantri.com - Math Battle 1v1)
    match /math_rooms/{roomId} {
      // Anyone can read/write (real-time multiplayer, no auth required for simplicity)
      allow read, write: if true;
    }
    
    // CCA Rooms (Bahasasantri.com - Cerdas Cermat Agama)
    match /cca_rooms/{roomId} {
      // Anyone can read/write (real-time multiplayer, no auth required for simplicity)
      allow read, write: if true;
    }
    
    // CCA Final Rooms (Bahasasantri.com - Final CCA Babak 3)
    match /cca_final_rooms/{roomId} {
      allow read, write: if true;
    }
    
    // App Settings (Bahasasantri.com - Admin toggles for CCA/Math)
    match /app_settings/{docId} {
      allow read, write: if true;
    }
  }
}

