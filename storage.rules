rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /report_photos/{reportId}/{fileName} {
      // Sederhanakan aturan: izinkan user yang login
      allow read, write, delete: if request.auth != null;
    }
    
    match /weekend_reports/{fileName} {
      // Weekend report photos: izinkan user yang login
      allow read, write, delete: if request.auth != null;
    }
  }
}
